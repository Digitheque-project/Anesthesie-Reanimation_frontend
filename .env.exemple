# =============================================================================
# Passerelle unique du CHU — SEULE variable réseau pour tout le front, côté navigateur ET côté
# serveur (app/api/accueil/*, app/api/users/* la relaient également, voir ces fichiers). Chaque
# appel ajoute lui-même son préfixe de service (voir lib/gateway.ts).
# Doit être fournie à la fois en --build-arg (Dockerfile, figée dans le bundle navigateur) ET en
# variable d'environnement au lancement du conteneur (lue à l'exécution par les routes API
# serveur) — les deux valeurs doivent être identiques.
# =============================================================================
NEXT_PUBLIC_GATEWAY_URL=

# Nom STABLE de ce service dans le registre central (pas son id, qui peut changer sans
# redéploiement côté registre — voir Anesthesie-Reanimation_backend). Sert à retrouver notre
# entrée dans le token de CHAQUE utilisateur (lib/auth/central-session.ts) — valeur par défaut
# si absent : "Anesthésie - Réanimation" (nom exact actuellement enregistré).
NEXT_PUBLIC_SERVICE_NAME=

# Page de connexion du SSO central — URL COMPLÈTE (pas une racine nue), utilisée telle quelle
# comme cible de redirection du navigateur. Ex. https://auth-client.example.com/login
NEXT_PUBLIC_CENTRAL_LOGIN_URL=
